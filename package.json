{
  "name": "workout-tracker",
  "private": true,
  "version": "2.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/write-version.mjs && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test src",
    "test:tz": "for tz in America/New_York America/Los_Angeles Asia/Kolkata Europe/London UTC Pacific/Auckland; do echo \"— $tz\"; TZ=$tz node --test src | grep -E '^# (pass|fail)'; done",
    "android:sync": "npm run build && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:run": "npm run android:sync && cap run android",
    "build:exercise-library": "node scripts/build-exercise-library.mjs",
    "compress:exercise-images": "node scripts/compress-exercise-images.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "7.5.0",
    "@capacitor/android": "7.6.8",
    "@capacitor/core": "7.6.8",
    "@capacitor/local-notifications": "7.0.7",
    "@fontsource-variable/manrope": "^5.3.0",
    "firebase": "11.10.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.31.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.8",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "sharp": "^0.35.3",
    "vite": "^8.0.12"
  }
}
